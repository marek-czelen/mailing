# Zmienne środowiskowe dla aplikacji React
# Wszystkie zmienne muszą zaczynać się od VITE_ żeby były dostępne w aplikacji

# URL do API backendu w środowisku produkcyjnym
# W development używamy http://localhost:3000
VITE_API_URL=https://your-production-api.com

# Inne konfiguracje
VITE_APP_NAME="Panel Mailingowy"
VITE_APP_VERSION="1.0.0"

# Opcjonalne - timeout dla requestów API (w ms)
VITE_API_TIMEOUT=10000

# Opcjonalne - czy wyświetlać szczegółowe logi
VITE_DEBUG=false