{
  "name": "src",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./src/bin/www.js",
    "dev": "babel-node ./src/bin/www.js",
    "clean": "rimraf dist",
    "build": "npm-run-all clean prod",
    "prod": "babel ./src --out-dir dist --copy-files",
    "watch:dev": "nodemon --inspect ./src/bin/www.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "debug": "~4.4.0",
    "express": "~4.21.2",
    "http-errors": "~2.0.0",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "openai": "^5.20.0",
    "run-all": "^1.0.1",
    "sequelize": "^6.37.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.7",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1"
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "./"
    ],
    "ext": "js",
    "ignore": [
      "*.test.ts"
    ],
    "delay": "3000",
    "execMap": {
      "ts": "ts-node"
    }
  }
}
