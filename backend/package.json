{
  "name": "src",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node ./src/bin/www.js",
    "watch:dev": "cross-env NODE_ENV=development nodemon --inspect ./src/bin/www.js",
    "build": "npm-run-all clean prod",
    "clean": "rimraf dist_server",
    "prod": "babel ./src --out-dir dist_server --copy-files",
    "start:built": "NODE_ENV=production node ./dist_server/bin/www.js",
    "postinstall": "npm run setup:production",
    "setup:production": "node -e \"if (process.env.NODE_ENV==='production'){console.log('Production environment detected')}\""
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "debug": "~4.4.0",
    "dotenv": "^16.6.1",
    "express": "~4.21.2",
    "express-validator": "^7.3.0",
    "http-errors": "~2.0.0",
    "imapflow": "^1.0.164",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.0",
    "morgan": "~1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.10",
    "openai": "^5.20.0",
    "poplib": "^0.1.7",
    "run-all": "^1.0.1",
    "sequelize": "^6.37.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.7",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "./"
    ],
    "ext": "js",
    "ignore": [
      "*.test.ts",
      "node_modules/",
      "dist/",
      "dist_server/",
      "logs/"
    ],
    "delay": "3000",
    "env": {
      "NODE_ENV": "development"
    }
  }
}
