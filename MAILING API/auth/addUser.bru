meta {
  name: addUser
  type: http
  seq: 3
}

post {
  url: {{backendUrl}}/auth/addUser
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "admin@admin.pl",
    "password":"admin"
  }
}

script:post-response {
  bru.setEnvVar("token",res.body.data.token)
}
