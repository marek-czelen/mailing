meta {
  name: sendEmail
  type: http
  seq: 15
}

post {
  url: {{backendUrl}}/mailing/sendEmail
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "smtp": {
